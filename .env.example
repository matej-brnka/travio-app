# Public frontend origin allowed by backend CORS and used for shared links.
FRONTEND_URL=https://brnka.aibr.cz

# Frontend API base URL baked into the production build.
# In Docker Compose with Traefik keep "/api".
VITE_API_URL=/api

# Production hostname routed by Traefik, e.g. brnka.aibr.cz.
TRAEFIK_PROD_HOST=brnka.aibr.cz

# Local test hostname routed by Traefik, usually localhost.
TRAEFIK_LOCAL_HOST=localhost

# E-mail used by Let's Encrypt ACME registration.
TRAEFIK_ACME_EMAIL=brnka.matej@gmail.com

# Supabase project URL for frontend auth client.
VITE_SUPABASE_URL=

# Supabase anonymous/public key for frontend auth client.
VITE_SUPABASE_ANON_KEY=

# Google Maps JavaScript API key used on the frontend.
VITE_GOOGLE_MAPS_KEY=

# Supabase database host / transaction pooler hostname for backend pg connection.
SUPABASE_URL=

# Supabase pooler port.
SUPABASE_PORT=

# Supabase database name.
SUPABASE_DATABASE=

# Supabase database user.
SUPABASE_USER=

# Supabase service role key / database password used by backend only.
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase project URL used by backend for JWKS / auth validation.
SUPABASE_PROJECT_URL=

# Google Places / Maps API key used by backend integrations.
GOOGLE_PLACES_API_KEY=

# User-Agent string required by yr.no API, e.g. "travio/1.0 you@example.com".
YR_NO_USER_AGENT=

# OpenAI API key used for itinerary generation.
OPENAI_API_KEY=

# OpenAI model name, e.g. gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI temperature for backend completions.
OPENAI_TEMPERATURE=0.7

# Optional OpenAI max tokens for backend completions.
OPENAI_MAX_TOKENS=2000
